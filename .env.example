# Optional: when set, the app uses GPT-4o-mini for response wording.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embedding model used to build the local FAISS knowledge index.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# FAISS L2 distance cutoff; lower values are more relevant.
RAG_SCORE_THRESHOLD=1.0
